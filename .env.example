# 실제 서버 주소. 끝에 / 없이 적는다 (예: https://lifeapi.weedool.com:8071)
NEXT_PUBLIC_API_BASE_URL=

# true: Mock 모드 사용, false: 실제 서버 연동
NEXT_PUBLIC_USE_MOCK=true

# Mock 환경에서 통과시킬 기관코드 (6자리)
NEXT_PUBLIC_MOCK_VALID_ORG_CODE=GGCF26

# Mock 계정 만료 제한 시간(초). 만료 화면 테스트 시 30 등으로 단축 가능
NEXT_PUBLIC_MOCK_TTL_SECONDS=600

# GA4 측정 ID
NEXT_PUBLIC_GA_ID=
